# FriendHost Bot - copie este arquivo para .env e preencha somente na VM.
# Nunca envie o .env para o GitHub, Discord, Vercel ou qualquer conversa.

# Token do bot: Discord Developer Portal > Applications > seu bot > Bot > Reset Token.
DISCORD_TOKEN=cole_o_token_do_bot_aqui

# ID do servidor Discord onde o bot sera executado.
# Ative o Modo desenvolvedor no Discord, clique com o botao direito no servidor e use Copiar ID.
GUILD_ID=cole_o_id_do_servidor_aqui

# ID da categoria onde os canais atendimento-* serao criados.
SUPPORT_CATEGORY_ID=cole_o_id_da_categoria_de_suporte_aqui

# URL do projeto: Supabase > Project Settings > API > Project URL.
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave exclusiva do servidor: Supabase > Project Settings > API > service_role.
# Esta chave ignora as politicas RLS. Nunca a use no site, navegador ou frontend.
SUPABASE_SERVICE_KEY=cole_a_service_role_key_nova_aqui

# Nome que aparece nos logs e rodapes dos embeds do Discord.
BOT_NAME=FriendHost Bot

# Intervalo, em segundos, para buscar novas mensagens de suporte. Recomendado: 8 ou mais.
SUPPORT_POLL_SECONDS=8

# true reenvia mensagens antigas ao iniciar. Normalmente deixe false para evitar duplicidade.
SUPPORT_SYNC_ON_START=false

# IDs dos cargos da equipe separados por virgula. Administradores sempre possuem acesso.
# Exemplo: STAFF_ROLE_IDS=123456789012345678,987654321098765432
STAFF_ROLE_IDS=cole_os_ids_dos_cargos_da_equipe_aqui

# Canal privado que recebera alertas de pedidos novos. Deixe vazio para desativar alertas.
ORDERS_CHANNEL_ID=

# Intervalo, em segundos, para verificar pedidos novos. Recomendado: 20 ou mais.
ORDERS_POLL_SECONDS=20

# true reenvia pedidos antigos quando o bot inicia. Normalmente deixe false.
ORDERS_SYNC_ON_START=false

# Canal honeypot anti-spam. Usuarios comuns que enviarem mensagem nele sao expulsos.
# O bot precisa das permissoes Expulsar membros, Gerenciar mensagens e Ler historico de mensagens.
HONEYPOT_CHANNEL_ID=cole_o_id_do_canal_honeypot_aqui

# Chave criada em Google AI Studio para o comando /assistente.
# Deixe vazio para desativar a IA. Nunca envie essa chave ao GitHub ou Discord.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Atualizacao segura pelo comando /atualizar_bot.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_REMOTE=origin
# Use master apos mesclar o PR; caso esteja testando uma branch, informe o nome dela aqui.
AUTO_UPDATE_BRANCH=master
